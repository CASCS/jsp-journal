{{- $names := slice -}}
{{- range .Params.authors -}}
  {{- if .family -}}
    {{- if .given -}}{{- $names = $names | append (printf "%s, %s" .family .given) -}}{{- else -}}{{- $names = $names | append .family -}}{{- end -}}
  {{- else -}}
    {{- $names = $names | append .name -}}
  {{- end -}}
{{- end -}}
@article{ {{- .File.ContentBaseName -}},
  title   = { {{ .Title }} },
  author  = { {{ delimit $names " and " }} },
  journal = { {{ site.Title }} },
  year    = { {{ .Date.Format "2006" }} },
  volume  = { {{ .Params.volume }} },
  number  = { {{ .Params.issue }} },
{{- with .Params.doi }}
  doi     = { {{ . }} },
{{- end }}
{{- with site.Params.issn }}
  issn    = { {{ . }} },
{{- end }}
{{- with .Params.pdf_url }}
  url     = { {{ . }} },
{{- end }}
}
